method foo(num : Rational) returns (res:Rational)
  requires num >= 0.0
  ensures num >= 2.0
{
    // skip
    // fmt.Printf("Positive number is: %v\n", num)
    vat tmp : Rational := num + 1
    assert tmp == (tmp - 1) + 1
    res := tmp
}

