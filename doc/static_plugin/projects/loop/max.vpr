domain IArray {
    function slot(a: IArray, i: Int): Ref
    function len(a: IArray): Int
    function first(r: Ref): IArray
    function second(r: Ref): Int
    
    axiom all_diff {
        forall a: IArray, i: Int ::
            { slot(a, i) } first(slot(a, i)) == a
            && second(slot(a, i)) == i
    }
    
    axiom len_nonneg {
        forall a: IArray :: { len(a) } len(a) >= 0
    }
}

field val: Int

define access(a) (forall j: Int ::
    0 <= j && j < len(a) ==> acc(slot(a, j).val))

method max(a: IArray) returns (res: Int)
    requires access(a)
    requires 0 < len(a)
    ensures access(a)
    ensures res >= slot(a, 0).val
{
    var m: Int := slot(a, 0).val
    var i: Int := 1
    
    while (i < len(a))
        invariant access(a)
        invariant 1 <= i && i <= len(a)
        invariant m >= slot(a, 0).val
        decreases len(a) - i
    {
        if (slot(a, i).val > m) {
            m := slot(a, i).val
        }
        i := i + 1
    }
    
    res := m
}