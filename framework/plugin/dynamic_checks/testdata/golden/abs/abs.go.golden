package notation

import checks "gpma/framework/plugin/dynamic_checks/check"

/*
@
assigns \nothing;
ensures (\result == x) || (\result == -x);
ensures \result >= 0;
*/
func Abs(x int) int {
	var __result int
	defer checks.CheckAt(__result == x || __result == -x, "../../../samples/projects/abs/abs.go", 5, "postcondition")
	defer checks.CheckAt(__result >= 0, "../../../samples/projects/abs/abs.go", 6, "postcondition")
	if x < 0 {
		{
			__result = -x
			return __result
		}
	}
	{
		__result = x
		return __result
	}
}
