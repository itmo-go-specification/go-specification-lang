package notation

import checks "gpma/framework/plugin/dynamic_checks/check"

/*
@
assigns \nothing;
ensures (\result == x) || (\result == -x);
ensures \result >= 0;
*/
func Abs(x int) int {
	var __result_0 int
	defer checks.CheckAt(__result_0 == x || __result_0 == -x, "../../../samples/projects/abs/abs.go", 5, "postcondition")
	defer checks.CheckAt(__result_0 >= 0, "../../../samples/projects/abs/abs.go", 6, "postcondition")
	if x < 0 {
		{
			__result_0 = -x
			return __result_0
		}
	}
	{
		__result_0 = x
		return __result_0
	}
}
