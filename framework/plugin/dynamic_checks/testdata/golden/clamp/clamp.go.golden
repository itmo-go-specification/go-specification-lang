package clamp

import checks "gpma/framework/plugin/dynamic_checks/check"

func clamp(x int, min int, max int) int {
	checks.CheckAt(min <= max, "../../../samples/projects/clamp/clamp.go", 4, "assertion")

	if x < min {
		return min
	}
	checks.CheckAt(x >= min, "../../../samples/projects/clamp/clamp.go", 10, "assertion")

	if x > max {
		return max
	}
	checks.CheckAt(x >= min && x <= max, "../../../samples/projects/clamp/clamp.go", 16, "assertion")

	return x
}
