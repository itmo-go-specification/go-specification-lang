package clamp

import checks "gpma/framework/plugin/dynamic_checks/check"

/*
@
requires min <= max;
ensures \result >= min;
ensures \result <= max;
*/
func clamp(x int, min int, max int) int {
	checks.CheckAt(min <= max, "../../../samples/projects/clamp_both/clamp.go", 5, "precondition")
	var __result_0 int
	defer func() {
		checks.CheckAt(__result_0 >= min, "../../../samples/projects/clamp_both/clamp.go", 6, "postcondition")
	}()
	defer func() {
		checks.CheckAt(__result_0 <= max, "../../../samples/projects/clamp_both/clamp.go", 7, "postcondition")
	}()
	checks.CheckAt(min <= max, "../../../samples/projects/clamp_both/clamp.go", 10, "assertion")

	if x < min {
		{
			__result_0 = min
			return __result_0
		}
	}
	checks.CheckAt(x >= min, "../../../samples/projects/clamp_both/clamp.go", 16, "assertion")

	if x > max {
		{
			__result_0 = max
			return __result_0
		}
	}
	checks.CheckAt(x >= min && x <= max, "../../../samples/projects/clamp_both/clamp.go", 22, "assertion")
	{
		__result_0 = x
		return __result_0
	}
}
