package clamp

import checks "gpma/framework/plugin/dynamic_checks/check"

/*
@
requires min <= max;
ensures \result >= min;
ensures \result <= max;
*/
func clamp(x int, min int, max int) int {
	checks.CheckAt(min <= max, "../../../samples/projects/clamp_both/clamp.go", 4, "precondition")
	var __result int
	defer checks.CheckAt(__result >= min, "../../../samples/projects/clamp_both/clamp.go", 5, "postcondition")
	defer checks.CheckAt(__result <= max, "../../../samples/projects/clamp_both/clamp.go", 6, "postcondition")
	checks.CheckAt(min <= max, "../../../samples/projects/clamp_both/clamp.go", 9, "assertion")

	if x < min {
		{
			__result = min
			return __result
		}
	}
	checks.CheckAt(x >= min, "../../../samples/projects/clamp_both/clamp.go", 15, "assertion")

	if x > max {
		{
			__result = max
			return __result
		}
	}
	checks.CheckAt(x >= min && x <= max, "../../../samples/projects/clamp_both/clamp.go", 21, "assertion")
	{
		__result = x
		return __result
	}
}
