package main

import checks "gpma/framework/plugin/dynamic_checks/check"

/*
@
requires non_negative(n);
ensures positive(\result);
ensures \result == inc(n);
*/
func IncBlockContract(n int) int {
	checks.CheckAt(non_negative(n), "../../../samples/projects/comments_fmt/comments_fmt.go", 20, "precondition")
	var __result_0 int
	defer func() {
		checks.CheckAt(positive(__result_0), "../../../samples/projects/comments_fmt/comments_fmt.go", 21, "postcondition")
	}()
	defer func() {
		checks.CheckAt(__result_0 == inc(n), "../../../samples/projects/comments_fmt/comments_fmt.go", 22, "postcondition")
	}()
	{
		__result_0 = n + 1
		return __result_0
	}
}

func Assertions(n int) int {
	checks.CheckAt(n == n, "../../../samples/projects/comments_fmt/comments_fmt.go", 29, "assertion")
	checks.CheckAt(n+0 == n, "../../../samples/projects/comments_fmt/comments_fmt.go", 31, "assertion")
	checks.CheckAt(!(n >= 0) || n >= 0, "../../../samples/projects/comments_fmt/comments_fmt.go", 33, "assertion")

	return n
}

func LoopLineAnnotation(n int) int {
	i := 0

	for i < n {
		checks.CheckAt(0 <= i && i <= n, "../../../samples/projects/comments_fmt/comments_fmt.go", 43, "loop invariant")
		__variant_before_1 := n - i
		i++
		checks.CheckAt(0 <= i && i <= n, "../../../samples/projects/comments_fmt/comments_fmt.go", 43, "loop invariant")
		__variant_after_2 := n - i
		checks.CheckAt(__variant_after_2 < __variant_before_1, "../../../samples/projects/comments_fmt/comments_fmt.go", 43, "loop variant")
	}

	return i
}

func LoopBlockAnnotation(n int) int {
	i := 0

	for i < n {
		i++
	}

	return i
}

func MixedFormatting(n int) int {
	checks.CheckAt(n == n, "../../../samples/projects/comments_fmt/comments_fmt.go", 69, "assertion")
	checks.CheckAt(n+0 == n+1-1, "../../../samples/projects/comments_fmt/comments_fmt.go", 70, "assertion")
	checks.CheckAt(!(n >= 0) || n+1 > 0, "../../../samples/projects/comments_fmt/comments_fmt.go", 76, "assertion")

	return n
}

func main() {
	_ = IncBlockContract(1)
	_ = Assertions(1)
	_ = LoopLineAnnotation(3)
	_ = MixedFormatting(1)
}
