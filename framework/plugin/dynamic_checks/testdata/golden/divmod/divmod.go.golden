package divmod

import checks "gpma/framework/plugin/dynamic_checks/check"

/*
@
requires b != 0;
ensures \result_0 == a / b;
ensures \result_1 == a % b;
ensures \result_0 * b + \result_1 == a;
*/
func DivMod(a, b int) (int, int) {
	checks.CheckAt(b != 0, "../../../samples/projects/divmod/divmod.go", 5, "precondition")
	var __result_0 int
	var __result_1 int
	defer checks.CheckAt(__result_0 == a/b, "../../../samples/projects/divmod/divmod.go", 6, "postcondition")
	defer checks.CheckAt(__result_1 == a%b, "../../../samples/projects/divmod/divmod.go", 7, "postcondition")
	defer checks.CheckAt(__result_0*b+__result_1 == a, "../../../samples/projects/divmod/divmod.go", 8, "postcondition")
	{
		__result_0 = a / b
		__result_1 = a % b
		return __result_0, __result_1
	}
}
