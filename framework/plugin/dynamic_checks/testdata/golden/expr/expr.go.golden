/*
@
requires x >= 0;
ensures \result >= 0;
assigns \nothing;
*/
func Abs(x int) int {
	checks.CheckAt(x >= 0, "../../../samples/projects/expr/expr.go", 60, "precondition")
	var __result_0 int
	defer checks.CheckAt(__result_0 >= 0, "../../../samples/projects/expr/expr.go", 61, "postcondition")
	if x < 0 {
		{
			__result_0 = -x
			return __result_0
		}
	}
	{
		__result_0 = x
		return __result_0
	}
}

/*
@
requires !(x == 0);
ensures \result != 0;
assigns \nothing;
*/
func Identity(x int) int {
	checks.CheckAt(!(x == 0), "../../../samples/projects/expr/expr.go", 73, "precondition")
	var __result_0 int
	defer checks.CheckAt(__result_0 != 0, "../../../samples/projects/expr/expr.go", 74, "postcondition")
	{
		__result_0 = x
		return __result_0
	}
}

/*
@
requires lo <= hi;
ensures \result >= lo;
ensures \result <= hi;
assigns \nothing;
*/
func Clamp(x, lo, hi int) int {
	checks.CheckAt(lo <= hi, "../../../samples/projects/expr/expr.go", 83, "precondition")
	var __result_0 int
	defer checks.CheckAt(__result_0 >= lo, "../../../samples/projects/expr/expr.go", 84, "postcondition")
	defer checks.CheckAt(__result_0 <= hi, "../../../samples/projects/expr/expr.go", 85, "postcondition")
	if x < lo {
		{
			__result_0 = lo
			return __result_0
		}
	}
	if x > hi {
		{
			__result_0 = hi
			return __result_0
		}
	}
	{
		__result_0 = x
		return __result_0
	}
}

/*
@
requires n > 0;
ensures \result == \old(n) + 1;
assigns \nothing;
*/
func Increment(n int) int {
	checks.CheckAt(n > 0, "../../../samples/projects/expr/expr.go", 100, "precondition")
	__old_1 := n
	var __result_0 int
	defer checks.CheckAt(__result_0 == __old_1+1, "../../../samples/projects/expr/expr.go", 101, "postcondition")
	{
		__result_0 = n + 1
		return __result_0
	}
}

