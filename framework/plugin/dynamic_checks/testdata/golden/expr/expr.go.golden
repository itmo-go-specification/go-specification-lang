package labeled

import checks "gpma/framework/plugin/dynamic_checks/check"

/*
@
requires x >= 0;
ensures \result == x + 1;
assigns \nothing;
*/
func AddOne(x int) int {
	checks.CheckAt(x >= 0, "../../../samples/projects/expr/expr.go", 10, "precondition")
	var __result_0 int
	defer checks.CheckAt(__result_0 == x+1, "../../../samples/projects/expr/expr.go", 11, "postcondition")
	{
		__result_0 = x + 1
		return __result_0
	}
}

