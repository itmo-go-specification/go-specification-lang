/*
@
requires n >= 0;
ensures \result == n * (n + 1) / 2;
assigns \nothing;
*/
func TriangleNumber(n int) int {
	checks.CheckAt(n >= 0, "../../../samples/projects/expr/expr.go", 120, "precondition")
	var __result_0 int
	defer checks.CheckAt(__result_0 == n*(n+1)/2, "../../../samples/projects/expr/expr.go", 121, "postcondition")
	{
		__result_0 = n * (n + 1) / 2
		return __result_0
	}
}

func AssertAdd(x, y int) {
	checks.CheckAt(x+y >= x, "../../../samples/projects/expr/expr.go", 129, "assertion")

	_ = x
	_ = y
}

func AssertMul(x int) {
	checks.CheckAt(x*2 == x+x, "../../../samples/projects/expr/expr.go", 135, "assertion")

	_ = x
}

func AssertSub(x int) {
	checks.CheckAt(x-x == 0, "../../../samples/projects/expr/expr.go", 140, "assertion")

	_ = x
}

func AssertNeq(x int) {
	checks.CheckAt(x != x+1, "../../../samples/projects/expr/expr.go", 145, "assertion")

	_ = x
}
