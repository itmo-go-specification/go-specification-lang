func Diff(a, b int) int {
	checks.CheckAt(b > a, "../../../samples/projects/expr/expr.go", 20, "precondition")
	var __result_0 int
	defer checks.CheckAt(__result_0 == b-a, "../../../samples/projects/expr/expr.go", 21, "postcondition")
	{
		__result_0 = b - a
		return __result_0
	}
}

