package notation

import checks "gpma/framework/plugin/dynamic_checks/check"

/*
@
requires \forall i integer; (0 <= i) && (i < n) ==> (a[i] >= 0);
ensures \result >= 0;
*/
func SumPositive(a []int, n int) int {
	checks.CheckAt(func() bool {
		for i := 0; i < n; i++ {
			if !(a[i] >= 0) {
				return false
			}
		}
		return true
	}(), "../../../samples/projects/forall/forall.go", 5, "precondition")
	var __result int
	defer checks.CheckAt(__result >= 0, "../../../samples/projects/forall/forall.go", 6, "postcondition")
	s := 0
	for i := 0; i < n; i++ {
		s += a[i]
	}
	{
		__result = s
		return __result
	}
}

/*
@
ensures \exists i integer; (0 <= i) && (i < n) && (\result == a[i]);
*/
func FirstElement(a []int, n int) int {
	var __result int
	defer checks.CheckAt(func() bool {
		for i := 0; i < n; i++ {
			if __result == a[i] {
				return true
			}
		}
		return false
	}(), "../../../samples/projects/forall/forall.go", 18, "postcondition")
	{
		__result = a[0]
		return __result
	}
}
