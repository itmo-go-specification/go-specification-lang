package main

import (
	"bufio"
	"fmt"
	checks "gpma/framework/plugin/dynamic_checks/check"
	"os"
	"strconv"
)

/*
@
requires num >= 0.0;
ensures num >= 2.0;
assigns \nothing;
*/
func foo(num float64) float64 {
	checks.CheckAt(num >= 0.000000, "../../../samples/projects/interactive/main.go", 12, "precondition")
	var __result_0 float64
	defer checks.CheckAt(num >= 2.000000, "../../../samples/projects/interactive/main.go", 13, "postcondition")
	fmt.Printf("Positive number is: %v\n", num)
	num++
	checks.CheckAt(num == (num-1)+1, "../../../samples/projects/interactive/main.go", 19, "assertion")
	{
		__result_0 = num
		return __result_0
	}
}

func main() {
	scanner := bufio.NewScanner(os.Stdin)

	fmt.Print("Enter positive number: ")
	scanner.Scan()

	input := scanner.Text()
	num, err := strconv.ParseFloat(input, 64)
	if err != nil {
		fmt.Printf("Error: '%s' is not number\n", input)
		os.Exit(1)
	}

	foo(num)
}
