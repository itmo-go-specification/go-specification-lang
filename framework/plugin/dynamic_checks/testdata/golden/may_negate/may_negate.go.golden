package notation

import checks "gpma/framework/plugin/dynamic_checks/check"

/*
@
requires (mode == \true) || (mode == \false);
assigns \nothing;
ensures ((!(mode == false)) || (\result == x)) &&

	((!(mode == true)) || (\result == -x));
*/
func mayNegate(x int, mode bool) int {
	checks.CheckAt(mode == true || mode == false, "../../../samples/projects/may_negate/may_negate.go", 4, "precondition")
	var __result int
	defer checks.CheckAt((!(mode == false) || __result == x) && (!(mode == true) || __result == -x), "../../../samples/projects/may_negate/may_negate.go", 6, "postcondition")
	if mode {
		{
			__result = -x
			return __result
		}
	}
	{
		__result = x
		return __result
	}
}
