package notation

import checks "gpma/framework/plugin/dynamic_checks/check"

/*
@
assigns \nothing;
ensures (\result == a) || (\result == b);
ensures (\result <= a) && (\result <= b);
*/
func min(a, b int) int {
	var __result_0 int
	defer checks.CheckAt(__result_0 == a || __result_0 == b, "../../../samples/projects/min/min.go", 5, "postcondition")
	defer checks.CheckAt(__result_0 <= a && __result_0 <= b, "../../../samples/projects/min/min.go", 6, "postcondition")
	if a < b {
		{
			__result_0 = a
			return __result_0
		}
	}
	{
		__result_0 = b
		return __result_0
	}
}
