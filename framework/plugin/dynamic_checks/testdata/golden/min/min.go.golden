package notation

import checks "gpma/framework/plugin/dynamic_checks/check"

/*
@
assigns \nothing;
ensures (\result == a) || (\result == b);
ensures (\result <= a) && (\result <= b);
*/
func min(a, b int) int {
	var __result int
	defer checks.CheckAt(__result == a || __result == b, "../../../samples/projects/min/min.go", 5, "postcondition")
	defer checks.CheckAt(__result <= a && __result <= b, "../../../samples/projects/min/min.go", 6, "postcondition")
	if a < b {
		{
			__result = a
			return __result
		}
	}
	{
		__result = b
		return __result
	}
}
