package main

import checks "gpma/framework/plugin/dynamic_checks/check"

/*
@
requires non_negative(n);
ensures positive(\result);
*/
func Inc(n int) int {
	checks.CheckAt(non_negative(n), "../../../samples/projects/predicate/main.go", 11, "precondition")
	var __result_0 int
	defer func() {
		checks.CheckAt(positive(__result_0), "../../../samples/projects/predicate/main.go", 12, "postcondition")
	}()
	{
		__result_0 = n - 1000
		return __result_0
	}
}

func main() {
	_ = Inc(100)
	_ = Inc(-1)
	_ = Inc(0)
	_ = Inc(-10)
}
