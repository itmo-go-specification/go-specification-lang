package main

import (
	"fmt"
	checks "gpma/framework/plugin/dynamic_checks/check"
)

/*
@
requires (f == \true);
assigns \nothing;
*/
func check(f bool) {
	checks.CheckAt(f == true, "../../../samples/projects/simple/main.go", 9, "precondition")
	fmt.Printf("Passed\n")
}

func main() {
	check(false)
}
