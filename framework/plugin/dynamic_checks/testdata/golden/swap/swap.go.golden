package notation

import checks "gpma/framework/plugin/dynamic_checks/check"

/*
@
assigns p, q;
ensures (*p == \old(*q)) && (*q == \old(*p));
*/
func swap(p *int, q *int) {
	__old_1 := *q
	__old_2 := *p
	defer checks.CheckAt(*p == __old_1 && *q == __old_2, "../../../samples/projects/swap/swap.go", 5, "postcondition")
	save := *p
	*p = *q
	*q = save
}
