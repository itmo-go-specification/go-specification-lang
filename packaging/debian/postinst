#!/bin/sh
set -e

if command -v gpma >/dev/null 2>&1; then
  gpma plugins | grep -q gobra || {
    echo "gpma: gobra plugin not registered" >&2
    exit 1
  }
fi

for f in /usr/lib/gpma/gobra/gobra.jar /usr/lib/gpma/bin/z3 /usr/lib/gpma/bin/Boogie; do
  if [ ! -f "$f" ]; then
    echo "gpma: missing bundled file $f" >&2
    exit 1
  fi
done

exit 0
