# Environment for the Gobra verifier (sourced by wrapper and gpma gobra plugin).
GOBRA_JAR=/usr/lib/gpma/gobra/gobra.jar
GOBRA_JAVA=java
GOBRA_JAVA_OPTS=-Xss128m
Z3_EXE=/usr/lib/gpma/bin/z3
BOOGIE_EXE=/usr/lib/gpma/bin/Boogie
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=true
GOBRA_BACKEND=native
LD_LIBRARY_PATH=/usr/lib/gpma/lib
