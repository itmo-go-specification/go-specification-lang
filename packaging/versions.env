# Pinned third-party versions for gpma distribution.
GPMA_VERSION="${GPMA_VERSION:-0.1.0}"

# Gobra verifier (Docker image tag matches framework/plugin/gobra default).
GOBRA_DOCKER_IMAGE="ghcr.io/viperproject/gobra:sha-7fa4f86"

# Z3 (same as viperproject/gobra workflow-container).
Z3_VERSION="4.8.7"
Z3_URL="https://github.com/Z3Prover/z3/releases/download/z3-${Z3_VERSION}/z3-${Z3_VERSION}-x64-ubuntu-16.04.zip"
Z3_BIN_PATH="z3-${Z3_VERSION}-x64-ubuntu-16.04/bin/z3"

# Boogie (same as viperproject/gobra workflow-container).
BOOGIE_URL="https://github.com/viperproject/boogie-builder/releases/download/bae82d3a7b383161/boogie-linux.zip"
BOOGIE_BIN_PATH="binaries-linux/Boogie"

# OpenSSL 1.1 compat libs for Boogie (Ubuntu 20.04 focal).
LIBSSL_DEB_URL="http://archive.ubuntu.com/ubuntu/pool/main/o/openssl/libssl1.1_1.1.1f-1ubuntu2.24_amd64.deb"
